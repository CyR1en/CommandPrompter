{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommandPrompter JSON Configuration",
  "description": "Documentation schema for presets.json. Action templates, gate messages, and conditions support placeholder and transformer syntax (default '{player}', '{0}', '{1:upper}'; configurable in config.yml under Syntax.Template). The runtime currently does not validate this file against JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompts", "post_commands"],
  "properties": {
    "prompts": {
      "type": "array",
      "description": "A list of prompt configurations using the 'type' discriminator.",
      "maxItems": 256,
      "items": {
        "type": "object",
        "oneOf": [
          { "$ref": "#/$defs/chatPrompt" },
          { "$ref": "#/$defs/anvilPrompt" },
          { "$ref": "#/$defs/playerUiPrompt" },
          { "$ref": "#/$defs/signPrompt" },
          { "$ref": "#/$defs/dialogPrompt" },
          { "$ref": "#/$defs/confirmationPrompt" },
          { "$ref": "#/$defs/itemPrompt" }
        ]
      }
    },
    "post_commands": {
      "type": "array",
      "description": "Commands executed after prompt flow events.",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/postCommand" }
    },
    "approval_gates": {
      "type": "array",
      "description": "Approval gates for operations requiring authorization.",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/approvalGate" }
    },
    "conditional_post_commands": {
      "type": "array",
      "description": "Conditional post-commands executed based on condition expressions.",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/conditionalPostCommand" }
    }
  },
  "$defs": {
    "titleDisplay": {
      "type": "object",
      "description": "Optional Adventure title wrapper used by every prompt record.",
      "additionalProperties": false,
      "required": ["main"],
      "properties": {
        "main": { "type": "string" },
        "sub": { "type": ["string", "null"] },
        "ticks": { "type": ["integer", "null"] }
      }
    },
    "cancelBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["send", "message", "clickable", "hover_message"],
      "properties": {
        "send": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1 },
        "clickable": { "type": "boolean" },
        "hover_message": { "type": "string", "minLength": 1 }
      }
    },
    "anvilButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show", "button_text", "button_icon", "button_hover_text", "custom_model_data"],
      "properties": {
        "show": { "type": "boolean" },
        "button_text": { "type": "string", "minLength": 1 },
        "button_icon": { "type": "string", "minLength": 1 },
        "button_hover_text": { "type": "string", "minLength": 1 },
        "custom_model_data": { "type": "integer", "minimum": 0 }
      }
    },
    "uiButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show", "slot", "button_text", "button_icon", "button_hover_text", "custom_model_data"],
      "properties": {
        "show": { "type": "boolean" },
        "slot": { "type": "integer", "minimum": 0, "maximum": 8 },
        "button_text": { "type": "string", "minLength": 1 },
        "button_icon": { "type": "string", "minLength": 1 },
        "button_hover_text": { "type": "string", "minLength": 1 },
        "custom_model_data": { "type": "integer", "minimum": 0 }
      }
    },
    "chatPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "prompt_text", "cancel"],
      "properties": {
        "type": { "const": "chat" },
        "id": { "type": "string", "minLength": 1 },
        "prompt_text": { "type": "string", "minLength": 1 },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "cancel": { "$ref": "#/$defs/cancelBehavior" }
      }
    },
    "anvilPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "prompt_text", "left_button", "right_button"],
      "properties": {
        "type": { "const": "anvil" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "prompt_text": { "type": "string" },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "left_button": { "$ref": "#/$defs/anvilButton" },
        "right_button": { "$ref": "#/$defs/anvilButton" }
      }
    },
    "playerUiPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "prompt_text"],
      "properties": {
        "type": { "const": "player_ui" },
        "id": { "type": "string", "minLength": 1 },
        "prompt_text": { "type": "string", "minLength": 1 },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "filter": { "type": "string" },
        "cancel_button": { "$ref": "#/$defs/uiButton" },
        "previous_button": { "$ref": "#/$defs/uiButton" },
        "next_button": { "$ref": "#/$defs/uiButton" }
      }
    },
    "signPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "prompt_text"],
      "properties": {
        "type": { "const": "sign" },
        "id": { "type": "string", "minLength": 1 },
        "prompt_text": { "type": "string", "minLength": 1 },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "default_lines": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        }
      }
    },
    "confirmationPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "prompt_text"],
      "properties": {
        "type": { "const": "confirmation" },
        "id": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "pattern": "^(?:[Gg][Uu][Ii]|[Cc][Hh][Aa][Tt]|[Dd][Ii][Aa][Ll][Oo][Gg])$"
        },
        "title": { "type": "string" },
        "prompt_text": { "type": "string" },
        "confirm_text": { "type": "string" },
        "cancel_text": { "type": "string" },
        "value_mode": { "type": "boolean", "default": false },
        "sound": { "type": "string" },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "itemPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "prompt_text"],
      "properties": {
        "type": { "const": "item" },
        "id": { "type": "string", "minLength": 1 },
        "prompt_text": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "output": { "type": "string" },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,64}$"
        },
        "sound": {
          "type": "string",
          "pattern": "^(?:[a-z0-9_.-]+:)?[a-z0-9_./-]+$",
          "maxLength": 256
        },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "postCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "execution_policy", "execute_as"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique identifier for this preset post-command." },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Command template to execute. Supports template placeholders (e.g. '{player}', '{0}', '{1:upper}'; delimiters configurable in config.yml under Syntax.Template). Leading slash is optional.",
          "examples": ["say [Audit] Completed by {player}", "eco give {player} 100"]
        },
        "execution_policy": { "type": "string", "enum": ["on_complete", "on_cancel"], "description": "Execution policy determining when this post-command runs." },
        "execute_as": { "type": "string", "enum": ["console", "player"], "description": "Execution privilege context." },
        "delay_ticks": { "type": "integer", "minimum": 0, "maximum": 72000, "default": 0, "description": "Execution delay in server ticks (0 to 72000)." }
      }
    },
    "trustedPresetAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "execute_as"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Action command template to execute. Supports template placeholders and transformers (e.g. '{player}', '{0}', '{1:math(*1.5)}'; configurable in config.yml under Syntax.Template). Leading slash is optional.",
          "examples": ["eco give {player} 50", "msg {player} Standard transfer recorded."]
        },
        "execute_as": { "type": "string", "enum": ["console", "player"], "description": "Execution privilege context." },
        "delay_ticks": { "type": "integer", "minimum": 0, "maximum": 72000, "default": 0, "description": "Execution delay in server ticks (0 to 72000)." }
      }
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "message"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,64}$",
          "description": "Unique identifier for this approval gate."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Target player expression or template placeholder (e.g. '{0}', '{player}'; configurable in config.yml under Syntax.Template).",
          "examples": ["{0}", "{player}"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Plain-text message presented to the target player. Supports template placeholders (e.g. '{player} wants to trade {0}'; configurable in config.yml under Syntax.Template).",
          "examples": ["{player} wants to trade with you. Respond below:"]
        },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30, "description": "Timeout in seconds before the gate expires (1 to 3600)." },
        "self_approval_policy": {
          "type": "string",
          "enum": ["auto_approve", "require_confirm"],
          "default": "auto_approve",
          "description": "Self-approval policy when the initiating player is also the target."
        },
        "on_deny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "execute_as"],
          "description": "Action executed when the gate is denied, timed out, or target disconnects.",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Deny command template. Supports template placeholders.",
              "examples": ["msg {player} {0} declined your request."]
            },
            "execute_as": { "type": "string", "enum": ["console", "player"] },
            "delay_ticks": { "type": "integer", "enum": [0], "default": 0 }
          }
        }
      }
    },
    "conditionalPostCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "execution_policy"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,64}$",
          "description": "Unique identifier for this conditional post-command."
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Condition expression evaluated before dispatch (e.g. '{1} >= 500' or '%vault_eco_balance% >= 1000'; template placeholders configurable in config.yml under Syntax.Template).",
          "examples": ["{1} >= 500", "%vault_eco_balance% >= 1000"]
        },
        "execution_policy": { "type": "string", "enum": ["on_complete", "on_cancel"], "description": "Execution policy determining when this condition evaluates." },
        "if_true": { "$ref": "#/$defs/trustedPresetAction" },
        "if_false": { "$ref": "#/$defs/trustedPresetAction" }
      },
      "anyOf": [
        { "required": ["if_true"] },
        { "required": ["if_false"] }
      ]
    },
    "dialogRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "input_type"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "input_type": { "type": "string", "enum": ["text", "number", "choice"] },
        "constraints": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "max_length": { "type": "integer", "minimum": 1 },
        "max_lines": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 }
      }
    },
    "actionButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "tooltip": { "type": "string" },
        "return": { "type": "string" }
      }
    },
    "dialogTypeConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["multi_action", "confirmation"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "multi_action" } } },
          "then": {
            "required": ["columns"],
            "properties": {
              "columns": { "type": "integer", "minimum": 1 },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/actionButton" }
              },
              "actions_source": { "type": "string", "const": "tab_completion" },
              "exit_action": { "$ref": "#/$defs/actionButton" }
            },
            "oneOf": [
              { "required": ["actions"] },
              { "required": ["actions_source"] }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "confirmation" } } },
          "then": {
            "required": ["confirm_action"],
            "properties": {
              "confirm_action": { "$ref": "#/$defs/actionButton" },
              "cancel_action": { "$ref": "#/$defs/actionButton" }
            }
          }
        }
      ]
    },
    "dialogPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "dialog_type"],
      "properties": {
        "type": { "const": "dialog" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sanitize": { "type": "boolean", "default": true },
        "title_display": { "$ref": "#/$defs/titleDisplay" },
        "base": {
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "enum": ["plain_message", "item"] },
                  "content": { "type": "string" },
                  "material": { "type": "string" },
                  "amount": { "type": "integer", "minimum": 1 },
                  "width": { "type": "integer", "minimum": 1, "maximum": 1024 }
                }
              }
            },
            "inputs": {
              "type": "array",
              "items": { "$ref": "#/$defs/dialogRow" }
            }
          }
        },
        "dialog_type": { "$ref": "#/$defs/dialogTypeConfig" }
      }
    }
  }
}
